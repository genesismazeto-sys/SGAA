# Compatibilidade legada. Em Windows, prefira a configuracao machine-local
# protegida por DPAPI:
# python tools/configure_cloud_oauth.py --provider google
APP_ENV=development
APP_PUBLIC_BASE_URL=http://localhost:5000

# Administrador raiz (configuracao por instalacao; nunca versionar valores reais).
# Endereco da conta raiz. Sem ele, uma instalacao nova usa o placeholder
# nao entregavel root-admin@example.invalid.
# APP_BOOTSTRAP_ADMIN_EMAIL=
# Hash PBKDF2 da chave de recuperacao (break-glass). Gere com:
# python -c "from app.security.passwords import hash_password; print(hash_password(input()))"
# Sem ele, o acesso por chave mestra fica indisponivel; o login normal continua.
# Use aspas simples: o hash contem '$'.
# APP_ROOT_MASTER_KEY_HASH=''
# Callbacks derivados automaticamente:
# Google   -> APP_PUBLIC_BASE_URL + /google/callback
# OneDrive futuro (adiado) -> APP_PUBLIC_BASE_URL + /onedrive/callback

# Compatibilidade legada para criptografar cloud_accounts.token_json.
# A ferramenta acima cria e protege automaticamente a chave machine-local.
# Gere com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Seleção de pasta (Google Picker). Configure pelo card Google Drive em
# Banco de Dados; estas variaveis permanecem apenas como compatibilidade legada.
GOOGLE_PICKER_API_KEY=
GOOGLE_APP_ID=
GOOGLE_SCOPES=https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/userinfo.email

# OneDrive permanece opcional e adiado; estas variaveis nao sao exigidas para
# a operacao Google Drive desta entrega.
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_TENANT_ID=
# MS_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Deprecated para Google Drive/OneDrive:
# GOOGLE_REDIRECT_URI
# MS_REDIRECT_URI
# OAUTH_REDIRECT_URI
# Em instalacoes antigas, GOOGLE_REDIRECT_URI e MS_REDIRECT_URI sao lidos apenas
# como compatibilidade quando APP_PUBLIC_BASE_URL não estiver definido.
# OAUTH_REDIRECT_URI não é usado para Google Drive ou OneDrive.
